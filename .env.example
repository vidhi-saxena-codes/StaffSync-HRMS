# StaffSync Enterprise HRMS - Environment Template
# Copy this file to .env and configure your environment variables

# Server Port
PORT=3000
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/staffsync_hrms
# Example MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/staffsync_hrms?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/staffsync_hrms

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here
